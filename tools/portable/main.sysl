@no_alloc
import sh.sysl.sd.Clock
import sh.sysl.spi.{Device,Config,Error as BusError}
import sh.sysl.sd.spi.{card}

// Unresolved board callbacks are deliberate: this archive proves that every
// instantiated driver path needs no OS/heap. A firmware port supplies the ABI.
extern "sd_port_clock" port_clock(hz: u32) -> bool
extern "sd_port_select" port_select(active: bool) -> bool
extern "sd_port_exchange" port_exchange(byte: u8, into: *u8) -> bool
extern "sd_port_now_us" port_now() -> u64
extern "sd_port_delay_us" port_delay(micros: u32)

struct Transport
end Transport
impl Device for Transport
    configure(*self, cfg: Config) -> Result[unit,BusError] = if port_clock(cfg.hz) then Ok(()) else Err(BusError.Io)
    select(*self) -> Result[unit,BusError] = if port_select(true) then Ok(()) else Err(BusError.Io)
    deselect(*self) -> Result[unit,BusError] = if port_select(false) then Ok(()) else Err(BusError.Io)
    exchange(*self, byte: u8) -> Result[u8,BusError]
        var out: u8 = 0xff
        if port_exchange(byte,&out) then Ok(out) else Err(BusError.Io)
struct PortClock
end PortClock
impl Clock for PortClock
    now_us(self) -> u64 = port_now()
    delay_us(*self, micros: u32) = port_delay(micros)

#if feature_fat
import sh.sysl.fat.mount
#endif

@export("sd_portability_probe")
probe() -> int
    var c = card(Transport(),PortClock())
    if c.initialize().is_err() then return 1
    var data: [512]u8
    if c.read_sector(0,data[..]).is_err() then return 2
    if c.write_sector(0,data[..]).is_err() || c.sync().is_err() then return 3
#if feature_fat
    var v = mount(&c,data[..]) match
        Ok(v) -> v
        Err(_) -> return 4
    var file = v.open("/probe.bin") match
        Ok(f) -> f
        Err(_) -> return 5
    var out: [512]u8
    if v.read(&file,out[..]).is_err() then return 6
    if v.flush().is_err() then return 7
#endif
    0

import sh.sysl.sd.native as native
import sh.sysl.sd.{Error,HostError}
extern "sd_native_configure" native_configure(hz: u32, width: u32) -> bool
extern "sd_native_command" native_command(index: u8, arg: u32, response: u32, words: *u32) -> bool
// A data callback stores the command's R1 in `status`.
extern "sd_native_read" native_read(index: u8, arg: u32, bytes: *u8, count: usize, status: *u32) -> bool
extern "sd_native_write" native_write(index: u8, arg: u32, bytes: *u8, count: usize, status: *u32) -> bool
private done(ok: bool) -> Result[unit,Error] = if ok then Ok(()) else Err(Error.Host(HostError.Io))
private answered(ok: bool, status: u32) -> Result[u32,Error] = if ok then Ok(status) else Err(Error.Host(HostError.Io))
struct NativeTransport
end NativeTransport
impl native.Host for NativeTransport
    configure(*self, hz: u32, width: native.BusWidth) -> Result[unit,Error]
        done(native_configure(hz,if width == native.BusWidth.Four then 4 else 1))
    command(*self, index: u8, arg: u32, response: native.Response) -> Result[[4]u32,Error]
        var words: [4]u32
        val kind: u32 = response match
            native.Response.Empty -> 0
            native.Response.R1 -> 1
            native.Response.R3 -> 2
            native.Response.R2 -> 3
        done(native_command(index,arg,kind,&words[0]))?
        Ok(words)
    read_data(*self, index: u8, arg: u32, out: []u8, timeout_us: u32) -> Result[u32,Error]
        var status: u32 = 0
        answered(native_read(index,arg,&out[0],out.len,&status),status)
    write_data(*self, index: u8, arg: u32, bytes: []const u8, timeout_us: u32) -> Result[u32,Error]
        var status: u32 = 0
        answered(native_write(index,arg,&bytes[0],bytes.len,&status),status)
struct NativeClock
end NativeClock
impl Clock for NativeClock
    now_us(self) -> u64 = port_now()
    delay_us(*self, micros: u32) = port_delay(micros)
@export("sd_native_portability_probe")
native_probe() -> int
    var c = native.card(NativeTransport(),NativeClock())
    if c.initialize().is_err() then return 1
    var bytes: [512]u8
    if c.read_sector(0,bytes[..]).is_err() || c.write_sector(0,bytes[..]).is_err() || c.sync().is_err() then return 2
    var bulk: [4096]u8
    if c.read_sectors(0,bulk[..]).is_err() || c.write_sectors(0,bulk[..]).is_err() then return 4
#if feature_fat
    var volume = mount(&c,bytes[..]).unwrap()
    var file = volume.create("NATIVE.TXT").unwrap()
    val payload: [16]u8 = [0;16]
    if volume.write(&file,payload[..]).is_err() || volume.flush().is_err() then return 3
#endif
    0
