module sh.sysl.sd.native
@no_alloc
#if feature_fat

import sh.sysl.sd.*
import sh.sysl.fat.{BlockDevice,DeviceError}

impl[H: Host, K: Clock] BlockDevice for Card[H,K]
    sector_size(self) -> usize = SECTOR_SIZE
    sectors(self) -> u64 = if self.ready then self.info.sectors else 0
    read(*self, sector: u64, out: []u8) -> Result[unit,DeviceError] = device_result(self.read_sector(sector,out))
    write(*self, sector: u64, data: []const u8) -> Result[unit,DeviceError] = device_result(self.write_sector(sector,data))
    override read_many(*self, sector: u64, out: []u8) -> Result[unit,DeviceError] = device_result(self.read_sectors(sector,out))
    override write_many(*self, sector: u64, data: []const u8) -> Result[unit,DeviceError] = device_result(self.write_sectors(sector,data))
    flush(*self) -> Result[unit,DeviceError] = device_result(self.sync())
#endif
