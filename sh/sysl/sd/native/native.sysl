module sh.sysl.sd.native
@no_alloc

import sh.sysl.sd.*

// The response a command expects, named by the specification's response types
// (section 4.9). R1 is the 48-bit CRC-checked shape, which R1b, R6 and R7 share;
// R2 is the 136-bit CID/CSD reply; R3 is the OCR, sent without a valid CRC.
enum Response
    Empty
    R1
    R2
    R3

enum BusWidth
    One
    Four

// Controller-specific adapters implement bounded commands and data transfers.
// R2 replies are bits 127..0, MSW first, as in STM32 SDMMC RESP1..RESP4.
// Data callbacks issue their command, move its data, and answer the command's
// own R1 card status. A card refuses a data command in that R1 (OUT_OF_RANGE,
// ADDRESS_ERROR, WP_VIOLATION and the other error bits of type R, section
// 4.10.1) and then sends or takes no data, so a host that sees an error bit in
// it answers the R1 at once rather than waiting out the data phase. The card
// classifies every R1 itself, and reads the card status again after each
// transfer for the errors found while executing it. A host reports only its
// controller's failures, as Error.Host.
trait Host
    max_blocks(self) -> usize = 65535
    configure(*self, hz: u32, width: BusWidth) -> Result[unit,Error]
    command(*self, index: u8, arg: u32, response: Response) -> Result[[4]u32,Error]
    read_data(*self, index: u8, arg: u32, out: []u8, timeout_us: u32) -> Result[u32,Error]
    write_data(*self, index: u8, arg: u32, bytes: []const u8, timeout_us: u32) -> Result[u32,Error]

// Card status (section 4.10.1). CARD_STATUS_ERRORS is every error bit (address,
// block length, erase, write protect, lock, CRC, illegal command, ECC, card
// controller, general error, overwrite and sequence errors); the CURRENT_STATE
// field and READY_FOR_DATA together say the card can take the next transfer.
const CARD_STATUS_ERRORS: u32 = 0xfdffe008
private const CURRENT_STATE: u32 = 0x1e00
private const STATE_TRAN: u32 = 0x800
private const READY_FOR_DATA: u32 = 0x100
// R6's status bits 15..13 (COM_CRC_ERROR, ILLEGAL_COMMAND, ERROR); the RCA is
// the upper half.
private const R6_ERRORS: u32 = 0xe000
private const RCA: u32 = 0xffff0000
// ACMD6's argument for a four-bit bus.
private const FOUR_BIT_BUS: u32 = 2

// The error a card status word reports, or None when no error bit is set. The
// card applies this to every status it reads; a host asks it whether a data
// command's R1 refused the transfer, so that it skips the data phase.
card_status_error(status: u32) -> Option[Error] = if status & CARD_STATUS_ERRORS != 0 then Some(Error.CardStatus(status)) else None

private[native] check_status(status: u32) -> Result[unit,Error]
    card_status_error(status) match
        Some(e) -> Err(e)
        None -> Ok(())

struct Card[H: Host, K: Clock]
    private[native] host: H
    private[native] clock: K
    private[native] config: Settings
    private[native] ready: bool
    private[native] info: Info
    private[native] rca: u32

    into_transport(self) -> H = self.host
    into_clock(self) -> K = self.clock

impl[H: Host, K: Clock] Media for Card[H,K]
    information(*self) -> Option[Info] = if self.ready then Some(self.info) else None

    initialize(*self) -> Result[Info,Error]
        self.ready = false
        self.info = NO_INFO
        val c = self.config
        c.validate()?
        self.host.configure(c.initial_hz,BusWidth.One)?
        self.clock.delay_us(1000) // at least 74 startup clocks
        self.host.command(GO_IDLE_STATE,0,Response.Empty)?
        val echo = self.host.command(SEND_IF_COND,IF_COND,Response.R1)?
        if echo[0] & IF_COND_VOLTAGE != IF_COND & IF_COND_VOLTAGE then return Err(Error.Voltage)
        if echo[0] & IF_COND_PATTERN != IF_COND & IF_COND_PATTERN then return Err(Error.Echo)
        val start = self.clock.now_us()
        var ocr: u32 = 0
        var attempts: u32 = 0
        loop
            check_status(self.host.command(APP_CMD,0,Response.R1)?[0])?
            ocr = self.host.command(ACMD_SD_SEND_OP_COND,OCR_CCS | OCR_VOLTAGES,Response.R3)?[0]
            if ocr & OCR_BUSY != 0 then break
            attempts += 1
            if self.clock.now_us() -% start >= u64(c.initialize_us) || attempts >= c.poll_limit || attempts > c.initialize_us / 1000 then return Err(Error.Timeout(Phase.Initialize))
            self.clock.delay_us(1000)
        if ocr & OCR_VOLTAGES == 0 then return Err(Error.Voltage)
        self.host.command(ALL_SEND_CID,0,Response.R2)?
        val assigned = self.host.command(SEND_RELATIVE_ADDR,0,Response.R1)?[0]
        if assigned & R6_ERRORS != 0 || assigned & RCA == 0 then return Err(Error.CardStatus(assigned))
        self.rca = assigned & RCA
        val words = self.host.command(SEND_CSD,self.rca,Response.R2)?
        var csd: [16]u8
        for i in 0..<csd.len do csd[i] = u8.wrap(words[i / 4] >> (24 - u32(i % 4) * 8))
        val info = csd_info(csd[..],ocr & OCR_CCS != 0)?
        check_status(self.host.command(SELECT_CARD,self.rca,Response.R1)?[0])?
        if !info.block_addressed() then check_status(self.host.command(SET_BLOCKLEN,u32(SECTOR_SIZE),Response.R1)?[0])?
        check_status(self.host.command(APP_CMD,self.rca,Response.R1)?[0])?
        // SCR (section 5.6): structure version 1.0, and SD_BUS_WIDTHS, whose
        // bit 0 (one-bit) is mandatory and bit 2 is four-bit support.
        var scr: [8]u8
        check_status(self.host.read_data(ACMD_SEND_SCR,0,scr[..],c.read_us)?)?
        if scr[0] >> 4 != 0 || scr[1] & 1 == 0 then return Err(Error.InvalidScr)
        val width = if scr[1] & 4 != 0 then BusWidth.Four else BusWidth.One
        if width == BusWidth.Four
            check_status(self.host.command(APP_CMD,self.rca,Response.R1)?[0])?
            check_status(self.host.command(ACMD_SET_BUS_WIDTH,FOUR_BIT_BUS,Response.R1)?[0])?
        self.host.configure(c.transfer_hz,width)?
        transfer_ready(self)?
        self.info = info
        self.ready = true
        Ok(info)

    read_sector(*self, sector: u64, out: []u8) -> Result[unit,Error]
        val address = argument(self.information(),sector,out.len)?
        check_status(self.host.read_data(READ_SINGLE_BLOCK,address,out,self.config.read_us)?)?
        read_status(self)

    write_sector(*self, sector: u64, bytes: []const u8) -> Result[unit,Error]
        val address = argument(self.information(),sector,bytes.len)?
        if self.info.write_protected then return Err(Error.WriteProtected)
        check_status(self.host.write_data(WRITE_BLOCK,address,bytes,self.config.program_us)?)?
        self.sync()

    // Bulk transfers are bounded by the host's data-path capacity. Each native
    // multiblock run is explicitly stopped, including after data errors. A
    // failed run is never retried: an already written prefix may be permanent.
    override read_sectors(*self, sector: u64, out: []u8) -> Result[unit,Error]
        span(self.information(),sector,out.len)?
        val maximum = self.host.max_blocks()
        if maximum == 0 then return Err(Error.InvalidSettings)
        var done: usize = 0
        while done < out.len / SECTOR_SIZE
            val left = out.len / SECTOR_SIZE - done
            val count = if left > maximum then maximum else left
            val arg = argument(self.information(),sector + u64(done),SECTOR_SIZE)?
            val into = out[done * SECTOR_SIZE..<(done + count) * SECTOR_SIZE]
            if count == 1
                check_status(self.host.read_data(READ_SINGLE_BLOCK,arg,into,self.config.read_us)?)?
                read_status(self)?
            else
                stopped(self,self.host.read_data(READ_MULTIPLE_BLOCK,arg,into,self.config.read_us))?
                self.sync()?
            done += count
        Ok(())

    override write_sectors(*self, sector: u64, bytes: []const u8) -> Result[unit,Error]
        span(self.information(),sector,bytes.len)?
        if self.info.write_protected && bytes.len != 0 then return Err(Error.WriteProtected)
        val maximum = self.host.max_blocks()
        if maximum == 0 then return Err(Error.InvalidSettings)
        var done: usize = 0
        while done < bytes.len / SECTOR_SIZE
            val left = bytes.len / SECTOR_SIZE - done
            val count = if left > maximum then maximum else left
            val arg = argument(self.information(),sector + u64(done),SECTOR_SIZE)?
            val from = bytes[done * SECTOR_SIZE..<(done + count) * SECTOR_SIZE]
            if count == 1 then check_status(self.host.write_data(WRITE_BLOCK,arg,from,self.config.program_us)?)?
            else stopped(self,self.host.write_data(WRITE_MULTIPLE_BLOCK,arg,from,self.config.program_us))?
            self.sync()?
            done += count
        Ok(())

    sync(*self) -> Result[unit,Error]
        if !self.ready then return Err(Error.NotInitialized)
        transfer_ready(self)

card[H: Host, K: Clock](host: H, clock: K, config: Settings = settings()) -> Card[H,K] = Card(host,clock,config,false,NO_INFO,0)

// Ends a multiblock run; sent whatever the transfer returned.
private stop[H: Host, K: Clock](c: *Card[H,K]) -> Result[unit,Error]
    check_status(c.host.command(STOP_TRANSMISSION,0,Response.R1)?[0])

// A multiblock run's outcome. A run the card refused in the command's R1 never
// entered the data state, so there is nothing to stop; every other run is
// stopped, and the transfer's own error wins over the stop's.
private stopped[H: Host, K: Clock](c: *Card[H,K], transfer: Result[u32,Error]) -> Result[unit,Error]
    if transfer is Ok(r1) then check_status(r1)?
    finish(transfer,stop(c))?
    Ok(())

// Reads the card status after a single-block read, where the card reports the
// transfer's error bits. Writes and multiblock runs are checked by `sync`.
private read_status[H: Host, K: Clock](c: *Card[H,K]) -> Result[unit,Error]
    check_status(c.host.command(SEND_STATUS,c.rca,Response.R1)?[0])

// Polls SEND_STATUS until the card is in the transfer state and ready for
// data, bounded by the programming deadline and the poll limit.
private transfer_ready[H: Host, K: Clock](c: *Card[H,K]) -> Result[unit,Error]
    val start = c.clock.now_us()
    var attempts: u32 = 0
    loop
        val status = c.host.command(SEND_STATUS,c.rca,Response.R1)?[0]
        check_status(status)?
        if status & (CURRENT_STATE | READY_FOR_DATA) == STATE_TRAN | READY_FOR_DATA then return Ok(())
        attempts += 1
        if c.clock.now_us() -% start >= u64(c.config.program_us) || attempts >= c.config.poll_limit || attempts > c.config.program_us / 1000 then return Err(Error.Timeout(Phase.Program))
        c.clock.delay_us(1000)
