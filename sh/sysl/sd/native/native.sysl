module sh.sysl.sd.native
@no_alloc

import sh.sysl.sd.{Clock,Error,Phase,Info,CardKind,Settings,settings,csd_info,SECTOR_SIZE}

enum Response
    None
    Short
    Long
    NoCrc

// Controller-specific adapters implement bounded commands and data transfers.
// Long replies are bits 127..0, MSW first, as in STM32 SDMMC RESP1..RESP4.
// Data callbacks issue their command and check R1 plus controller data errors.
trait Host
    max_blocks(self) -> usize = 65535
    configure(*self, hz: u32, width: u32) -> Result[unit,Error]
    command(*self, index: u32, arg: u32, response: Response) -> Result[[4]u32,Error]
    read_data(*self, index: u32, arg: u32, out: []u8, timeout_us: u32) -> Result[unit,Error]
    write_data(*self, index: u32, arg: u32, bytes: []const u8, timeout_us: u32) -> Result[unit,Error]

const R1_ERRORS: u32 = 0xfdffe008
check_status(status: u32) -> Result[unit,Error]
    if status & R1_ERRORS != 0 then Err(Error.CardStatus(status)) else Ok(())

struct Card[H: Host, K: Clock]
    private[native] host: H
    private[native] clock: K
    private[native] config: Settings
    private[native] ready: bool
    private[native] info: Info
    private[native] rca: u32

    information(self) -> Option[Info] = if self.ready then Some(self.info) else None
    into_transport(self) -> H = self.host
    into_clock(self) -> K = self.clock
    initialize(*self) -> Result[Info,Error]
        self.ready = false
        val c = self.config
        if c.initial_hz < 100000 || c.initial_hz > 400000 || c.transfer_hz < c.initial_hz || c.transfer_hz > 25000000 || c.initialize_us == 0 || c.read_us == 0 || c.program_us == 0 || c.poll_limit == 0 then return Err(Error.InvalidSettings)
        self.host.configure(c.initial_hz,1)?
        self.clock.delay_us(1000) // at least 74 startup clocks
        self.host.command(0,0,Response.None)?
        val echo = self.host.command(8,0x1aa,Response.Short)?
        if echo[0] & 0xf00 != 0x100 then return Err(Error.Voltage)
        if echo[0] & 255 != 0xaa then return Err(Error.Echo)
        val start = self.clock.now_us()
        var ocr: u32 = 0
        var attempts: u32 = 0
        loop
            check_status(self.host.command(55,0,Response.Short)?[0])?
            ocr = self.host.command(41,0x40ff8000,Response.NoCrc)?[0]
            if ocr & 0x80000000 != 0 then break
            attempts += 1
            if self.clock.now_us() - start >= u64(c.initialize_us) || attempts >= c.poll_limit || attempts > c.initialize_us / 1000 then return Err(Error.Timeout(Phase.Initialize))
            self.clock.delay_us(1000)
        if ocr & 0x00ff8000 == 0 then return Err(Error.Voltage)
        self.host.command(2,0,Response.Long)?
        val assigned = self.host.command(3,0,Response.Short)?[0]
        if assigned & 0xe000 != 0 || assigned >> 16 == 0 then return Err(Error.CardStatus(assigned))
        self.rca = assigned & 0xffff0000
        val words = self.host.command(9,self.rca,Response.Long)?
        var csd: [16]u8
        for i in 0usize..<16 do csd[i] = u8(words[i / 4] >> (24 - u32(i % 4) * 8))
        val info = csd_info(csd[..],ocr & 0x40000000 != 0)?
        check_status(self.host.command(7,self.rca,Response.Short)?[0])?
        if !info.block_addressed() then check_status(self.host.command(16,512,Response.Short)?[0])?
        check_status(self.host.command(55,self.rca,Response.Short)?[0])?
        var scr: [8]u8
        self.host.read_data(51,0,scr[..],c.read_us)?
        if scr[0] >> 4 != 0 || scr[1] & 1 == 0 then return Err(Error.InvalidScr)
        val width: u32 = if scr[1] & 4 != 0 then 4 else 1
        if width == 4
            check_status(self.host.command(55,self.rca,Response.Short)?[0])?
            check_status(self.host.command(6,2,Response.Short)?[0])?
        self.host.configure(c.transfer_hz,width)?
        self.info = info
        self.ready = true
        val settled = self.sync()
        if settled.is_err() then self.ready = false
        settled?
        Ok(info)
    read_sector(*self, sector: u64, out: []u8) -> Result[unit,Error]
        val address = address(self,sector,out.len)?
        self.host.read_data(17,address,out,self.config.read_us)
    write_sector(*self, sector: u64, bytes: []const u8) -> Result[unit,Error]
        val address = address(self,sector,bytes.len)?
        if self.info.write_protected then return Err(Error.WriteProtected)
        self.host.write_data(24,address,bytes,self.config.program_us)?
        self.sync()
    // Bulk transfers are bounded by the host's data-path capacity. Each native
    // multiblock run is explicitly stopped, including after data errors. A
    // failed run is never retried: an already written prefix may be permanent.
    read_sectors(*self, sector: u64, out: []u8) -> Result[unit,Error]
        span(self,sector,out.len)?
        val maximum = self.host.max_blocks()
        if maximum == 0 then return Err(Error.InvalidSettings)
        var done: usize = 0
        while done < out.len / 512
            val left = out.len / 512 - done
            val count = if left > maximum then maximum else left
            val arg = address(self,sector + u64(done),512)?
            val into = out[done * 512..<(done + count) * 512]
            if count == 1 then self.host.read_data(17,arg,into,self.config.read_us)?
            else
                val result = self.host.read_data(18,arg,into,self.config.read_us)
                val stopped = self.host.command(12,0,Response.Short)
                result?
                check_status(stopped?[0])?
                self.sync()?
            done += count
        Ok(())
    write_sectors(*self, sector: u64, bytes: []const u8) -> Result[unit,Error]
        span(self,sector,bytes.len)?
        if self.info.write_protected && bytes.len != 0 then return Err(Error.WriteProtected)
        val maximum = self.host.max_blocks()
        if maximum == 0 then return Err(Error.InvalidSettings)
        var done: usize = 0
        while done < bytes.len / 512
            val left = bytes.len / 512 - done
            val count = if left > maximum then maximum else left
            val arg = address(self,sector + u64(done),512)?
            val from = bytes[done * 512..<(done + count) * 512]
            if count == 1 then self.host.write_data(24,arg,from,self.config.program_us)?
            else
                val result = self.host.write_data(25,arg,from,self.config.program_us)
                val stopped = self.host.command(12,0,Response.Short)
                result?
                check_status(stopped?[0])?
            self.sync()?
            done += count
        Ok(())
    sync(*self) -> Result[unit,Error]
        if !self.ready then return Err(Error.NotInitialized)
        val start = self.clock.now_us()
        var attempts: u32 = 0
        loop
            val status = self.host.command(13,self.rca,Response.Short)?[0]
            check_status(status)?
            if status & 0x1f00 == 0x900 then return Ok(())
            attempts += 1
            if self.clock.now_us() - start >= u64(self.config.program_us) || attempts >= self.config.poll_limit || attempts > self.config.program_us / 1000 then return Err(Error.Timeout(Phase.Program))
            self.clock.delay_us(1000)

card[H: Host, K: Clock](host: H, clock: K, config: Settings = settings()) -> Card[H,K] = Card(host,clock,config,false,Info(CardKind.Sdsc,0,false),0)
private address[H: Host, K: Clock](c: *Card[H,K], sector: u64, length: usize) -> Result[u32,Error]
    if !c.ready then return Err(Error.NotInitialized)
    if length != SECTOR_SIZE then return Err(Error.BadLength)
    if sector >= c.info.sectors then return Err(Error.OutOfRange)
    val address = if c.info.block_addressed() then sector else sector * 512
    if address > 0xffffffff then return Err(Error.OutOfRange)
    Ok(u32(address))

private span[H: Host, K: Clock](c: *Card[H,K], sector: u64, length: usize) -> Result[unit,Error]
    if !c.ready then return Err(Error.NotInitialized)
    if length % 512 != 0 then return Err(Error.BadLength)
    val count = u64(length / 512)
    if sector > c.info.sectors || count > c.info.sectors - sector then return Err(Error.OutOfRange)
    Ok(())
