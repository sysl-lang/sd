module sh.sysl.sd.native
@tests
import sh.sysl.sd.*

private struct Ticker
    now: u64
    frozen: bool

private ticker() -> Ticker = Ticker(0,false)
impl Clock for Ticker
    now_us(self) -> u64 = self.now
    delay_us(*self, micros: u32) = if !self.frozen then self.now +%= u64(micros)

private struct Fake
    clock: u32
    width: BusWidth
    calls: u32
    attempts: u32
    busy: u32
    not_ready: bool
    bad_echo: bool
    bad_scr: bool
    one_bit: bool
    protected: bool
    fail: bool
    address: u32
    maximum: usize
    stops: u32
    multi_reads: u32
    multi_writes: u32
    fail_data: bool
    fail_stop: bool
    bad_status: u32
    data: [4096]u8
private fake() -> Fake = Fake(clock = 0, width = BusWidth.One, calls = 0, attempts = 0, busy = 0, not_ready = false, bad_echo = false, bad_scr = false,
    one_bit = false, protected = false, fail = false, address = 0, maximum = 65535, stops = 0, multi_reads = 0, multi_writes = 0,
    fail_data = false, fail_stop = false, bad_status = 0, data = [0;4096])
impl Host for Fake
    override max_blocks(self) -> usize = self.maximum
    configure(*self, hz: u32, width: BusWidth) -> Result[unit,Error]
        assert(hz <= 25000000)
        self.clock = hz
        self.width = width
        Ok(())
    command(*self, index: u8, arg: u32, response: Response) -> Result[[4]u32,Error]
        self.calls += 1
        if self.fail then return Err(Error.Host(HostError.Timeout))
        var out: [4]u32 = [0;4]
        index match
            0 -> assert(response == Response.Empty && self.width == BusWidth.One)
            8 ->
                assert(response == Response.R1 && arg == 0x1aa)
                out[0] = if self.bad_echo then 0x1ab else 0x1aa
            55 -> assert(response == Response.R1 && (arg == 0 || arg == 0x12340000))
            41 ->
                assert(response == Response.R3 && arg == 0x40ff8000)
                self.attempts += 1
                out[0] = if self.not_ready || self.attempts < 3 then 0x00ff8000 else 0xc0ff8000
            2 -> assert(response == Response.R2)
            3 ->
                assert(response == Response.R1)
                out[0] = 0x12340700
            9 ->
                assert(response == Response.R2 && arg == 0x12340000)
                out = [0x400e0032,0x5b590000,0x001f0000,if self.protected then 0x02402001u32 else 0x02400001u32]
            7 -> assert(response == Response.R1 && arg == 0x12340000)
            6 -> assert(response == Response.R1 && arg == 2)
            12 ->
                assert(response == Response.R1)
                self.stops += 1
                if self.fail_stop then return Err(Error.Host(HostError.Timeout))
            13 ->
                assert(response == Response.R1 && arg == 0x12340000)
                out[0] = if self.busy > 0 then 0xe00 else 0x900
                if self.busy > 0 then self.busy -= 1
                out[0] |= self.bad_status
            _ -> assert(false,s"unexpected native command $index")
        Ok(out)
    read_data(*self, index: u8, arg: u32, out: []u8, timeout_us: u32) -> Result[unit,Error]
        if index == 18 then self.multi_reads += 1
        if self.fail then return Err(Error.Host(HostError.Io))
        if self.fail_data then return Err(Error.Host(HostError.DataCrc))
        if index == 51
            assert(out.len == 8)
            for i in 0..<8 do out[i] = 0
            out[0] = if self.bad_scr then 0xf2 else 2
            out[1] = if self.one_bit then 1 else 5
        else
            assert((index == 17 || index == 18) && out.len % 512 == 0)
            self.address = arg
            for i in 0..<out.len do out[i] = self.data[usize(arg % 8) * 512 + i]
        Ok(())
    write_data(*self, index: u8, arg: u32, bytes: []const u8, timeout_us: u32) -> Result[unit,Error]
        assert((index == 24 || index == 25) && bytes.len % 512 == 0)
        if index == 25 then self.multi_writes += 1
        if self.fail then return Err(Error.Host(HostError.Io))
        if self.fail_data then return Err(Error.Host(HostError.Underrun))
        self.address = arg
        for i in 0..<bytes.len do self.data[usize(arg % 8) * 512 + i] = bytes[i]
        self.busy = 2
        Ok(())

@test("native SD: initialization assigns RCA, parses CSD/SCR and negotiates four-bit transfer speed")
initialize_native()
    var c = card(fake(),ticker())
    val info = c.initialize().unwrap()
    assert(info.kind == CardKind.Sdhc && info.sectors == 32768 && !info.write_protected)
    assert(c.host.width == BusWidth.Four && c.host.clock == 8000000 && c.host.attempts == 3)
    assert(c.information() == Some(info))
    var b = fake()
    b.one_bit = true
    c = card(b,ticker())
    c.initialize().unwrap()
    assert(c.host.width == BusWidth.One)

@test("native SD: bounded sector transfers, readiness polling, addressing and write protection")
sectors_native()
    var c = card(fake(),ticker())
    var bytes: [512]u8 = [0;512]
    assert(c.read_sector(0,bytes[..]).err() == Some(Error.NotInitialized))
    c.initialize().unwrap()
    for i in 0..<512 do bytes[i] = u8.wrap(i * 7)
    c.write_sector(32767,bytes[..]).unwrap()
    assert(c.host.address == 32767 && c.host.busy == 0)
    var out: [512]u8
    c.read_sector(32767,out[..]).unwrap()
    for i in 0..<512 do assert(out[i] == bytes[i])
    assert(c.read_sector(32768,out[..]).err() == Some(Error.OutOfRange))
    assert(c.read_sector(0,out[..<511]).err() == Some(Error.BadLength))
    var protected = fake()
    protected.protected = true
    c = card(protected,ticker())
    assert(c.initialize().unwrap().write_protected)
    assert(c.write_sector(0,bytes[..]).err() == Some(Error.WriteProtected))

@test("native SD: invalid settings make no host call")
invalid_settings_native()
    var c = card(fake(),ticker(),settings(initial_hz = 0))
    assert(c.initialize().err() == Some(Error.InvalidSettings) && c.host.calls == 0)

@test("native SD: a bad SEND_IF_COND echo fails initialization")
bad_echo_native()
    var b = fake()
    b.bad_echo = true
    var c = card(b,ticker())
    assert(c.initialize().err() == Some(Error.Echo) && c.information().is_none())

@test("native SD: an SCR of an unknown structure fails initialization")
bad_scr_native()
    var b = fake()
    b.bad_scr = true
    var c = card(b,ticker())
    assert(c.initialize().err() == Some(Error.InvalidScr) && c.information().is_none())

@test("native SD: a clock that wraps while the card powers up still initializes")
wrapping_clock_native()
    var b = fake()
    b.busy = 3
    var wrapping = ticker()
    wrapping.now = 0xfffffffffffffc00
    var c = card(b,wrapping)
    assert(c.initialize().is_ok())

@test("native SD: a card that never powers up on a frozen clock is bounded by the poll limit")
frozen_initialization_native()
    var b = fake()
    b.not_ready = true
    var frozen = ticker()
    frozen.frozen = true
    var c = card(b,frozen,settings(initialize_us = 2000))
    assert(c.initialize().err() == Some(Error.Timeout(Phase.Initialize)) && c.host.attempts < 10)

@test("native SD: a host controller failure reaches the caller as Error.Host")
host_failure_native()
    var b = fake()
    b.fail = true
    var c = card(b,ticker())
    assert(c.initialize().err() == Some(Error.Host(HostError.Timeout)) && c.information().is_none())
    assert(check_status(1 << 26).err() == Some(Error.CardStatus(1 << 26)))
    assert(check_status(0x900).is_ok())

@test("native SD: card_status_error classifies error bits and ignores state bits")
card_status_error_native()
    assert(card_status_error(0x900) == None)
    assert(card_status_error(1 << 25) == None)
    assert(card_status_error(CARD_STATUS_ERRORS) == Some(Error.CardStatus(CARD_STATUS_ERRORS)))
    for bit in [31u32,30,29,28,27,26,24,23,22,21,20,19,18,17,16,15,14,13,3]
        assert(card_status_error(0x900 | (1 << bit)) == Some(Error.CardStatus(0x900 | (1 << bit))))

@test("native SD: error bits in the card status reach the caller without the host checking R1, on every data path")
card_status_without_host_native()
    val bits = 1u32 << 31
    var bytes: [1024]u8 = [0;1024]
    var out: [1024]u8
    var c = card(fake(),ticker())
    c.initialize().unwrap()
    c.host.bad_status = bits
    assert(c.read_sector(0,out[..<512]).err() == Some(Error.CardStatus(0x900 | bits)))
    assert(c.read_sectors(0,out[..<512]).err() == Some(Error.CardStatus(0x900 | bits)))
    assert(c.read_sectors(0,out[..]).err() == Some(Error.CardStatus(0x900 | bits)))
    assert(c.write_sector(0,bytes[..<512]).err() == Some(Error.CardStatus(0xe00 | bits)))
    c.host.busy = 0
    assert(c.write_sectors(0,bytes[..<512]).err() == Some(Error.CardStatus(0xe00 | bits)))
    c.host.busy = 0
    assert(c.write_sectors(0,bytes[..]).err() == Some(Error.CardStatus(0xe00 | bits)))
    assert(c.host.multi_reads == 1 && c.host.multi_writes == 1 && c.host.stops == 2)
    c.host.bad_status = 0
    c.host.busy = 0
    c.read_sector(0,out[..<512]).unwrap()
    c.write_sectors(0,bytes[..]).unwrap()

#if feature_fat
import sh.sysl.fat.{BlockDevice,DeviceError}

@test("native SD FAT adapter: a host failure reaches the caller as Io carrying sd's own code, unchanged")
fat_io_code_native()
    var c = card(fake(),ticker())
    c.initialize().unwrap()
    var out: [512]u8
    assert(c.read(0,out[..]).is_ok())
    c.host.fail = true
    assert(c.read(0,out[..]) == Err(DeviceError.Io(2)))
    assert(c.write(0,out[..]) == Err(DeviceError.Io(2)))
    assert(c.read(32768,out[..]) == Err(DeviceError.OutOfRange))
    assert(c.read(0,out[..<511]) == Err(DeviceError.BadLength))
#endif

@test("native SD: a failed reinitialization forgets the previous card")
reinitialize_native()
    var c = card(fake(),ticker())
    c.initialize().unwrap()
    c.host.fail = true
    assert(c.initialize().err() == Some(Error.Host(HostError.Timeout)))
    assert(c.information().is_none() && c.info == NO_INFO && !c.ready)

@test("native SD: initialization publishes the card only once it reaches the transfer state")
initialize_waits_for_transfer_state()
    var b = fake()
    b.busy = 1000
    var frozen = ticker()
    frozen.frozen = true
    var c = card(b,frozen,settings(program_us = 2000))
    assert(c.initialize().err() == Some(Error.Timeout(Phase.Program)))
    assert(c.information().is_none() && c.info == NO_INFO)
    c.host.busy = 1
    c.clock.frozen = false
    assert(c.initialize().is_ok() && c.information().is_some() && c.host.busy == 0)

@test("native SD: data errors propagate and programming timeouts never retry accepted writes")
program_native()
    var c = card(fake(),ticker())
    c.initialize().unwrap()
    c.host.fail = true
    var bytes: [512]u8
    assert(c.read_sector(0,bytes[..]).err() == Some(Error.Host(HostError.Io)))
    assert(c.write_sector(0,bytes[..]).err() == Some(Error.Host(HostError.Io)))
    c.host.fail = false
    c.host.busy = 100
    c.clock.frozen = true
    c.config.program_us = 2000
    assert(c.sync().err() == Some(Error.Timeout(Phase.Program)))

@test("native SD bulk: host-limited runs increment addresses, stop each command and preserve all sector data")
bulk_native()
    var bus = fake()
    bus.maximum = 3
    var c = card(bus,ticker())
    c.initialize().unwrap()
    var bytes: [4096]u8 = [0;4096]
    for i in 0..<4096 do bytes[i] = u8.wrap(i * 13 + i / 512)
    c.write_sectors(0,bytes[..]).unwrap()
    assert(c.host.multi_writes == 3 && c.host.stops == 3 && c.host.address == 6)
    var out: [4096]u8
    c.read_sectors(0,out[..]).unwrap()
    assert(c.host.multi_reads == 3 && c.host.stops == 6 && c.host.address == 6)
    for i in 0..<4096 do assert(out[i] == bytes[i])
    val calls = c.host.calls
    assert(c.read_sectors(32768,[]).is_ok() && c.write_sectors(32768,[]).is_ok())
    assert(c.host.calls == calls)
    assert(c.read_sectors(32767,out[..]).err() == Some(Error.OutOfRange))
    assert(c.write_sectors(0,bytes[..<513]).err() == Some(Error.BadLength))
    c.host.maximum = 0
    assert(c.read_sectors(0,out[..]).err() == Some(Error.InvalidSettings))

@test("native SD bulk: stop is attempted after data failure, successful data requires stop success and writes are never retried")
bulk_failures()
    var c = card(fake(),ticker())
    c.initialize().unwrap()
    c.host.fail_data = true
    var bytes: [1024]u8 = [0;1024]
    assert(c.write_sectors(0,bytes[..]).err() == Some(Error.Host(HostError.Underrun)))
    assert(c.host.multi_writes == 1 && c.host.stops == 1)
    assert(c.read_sectors(0,bytes[..]).err() == Some(Error.Host(HostError.DataCrc)))
    assert(c.host.stops == 2)
    c.host.fail_data = false
    c.host.fail_stop = true
    assert(c.read_sectors(0,bytes[..]).err() == Some(Error.Host(HostError.Timeout)))
    assert(c.host.stops == 3)
