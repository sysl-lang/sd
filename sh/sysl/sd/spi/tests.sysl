module sh.sysl.sd.spi
@tests

import sh.sysl.sd.{Clock,Error,Phase,Info,Media,Settings,settings,CardKind,NO_INFO}
import sh.sysl.spi.{Device,Config,Mode,BitOrder,Error as BusError}
import sysl.buf.{Buf,buf_filled}

// Test-only protocol peer. CRC implementations intentionally differ from the
// driver's: no production command, capacity or CRC helper is used here.
private ref_crc(data: []const u8) -> u16
    var crc: u16 = 0
    for byte in data
        crc ^= u16(byte) << 8
        for _ in 0..<8 do crc = if crc & 0x8000 != 0 then (crc << 1) ^ 0x1021 else crc << 1
    crc
private ref_command(data: []const u8) -> u8
    // Long division of the payload followed by seven zero bits by x^7+x^3+1.
    var remainder: u16 = 0
    for byte in data
        for bit in 0u32..<8
            remainder = (remainder << 1) | u16((byte >> (7 - bit)) & 1)
            if remainder & 0x80 != 0 then remainder ^= 0x89
    for _ in 0..<7
        remainder <<= 1
        if remainder & 0x80 != 0 then remainder ^= 0x89
    u8((remainder << 1) | 1)

@test("protocol peer CRC: independent polynomial division agrees with SD golden command bytes")
reference_crc()
    assert(ref_command([0x40u8,0,0,0,0]) == 0x95)
    assert(ref_command([0x48u8,0,0,1,0xaa]) == 0x87)

// The time is owned by each test and shared with the bus the way a board timer is:
// the bus advances it on every byte, and the Card reads it through its own handle.
// A tick of zero freezes the bus's contribution.
struct Time
    now: u64
    tick: u64
end Time

struct FakeClock
    time: *Time
end FakeClock
impl Clock for FakeClock
    now_us(self) -> u64 = self.time.now
    delay_us(*self, micros: u32)
        if self.time.tick != 0 then self.time.now +%= u64(micros)

struct Fake
    storage: Buf[u8]
    legacy: bool
    block: bool
    csd: [16]u8
    active: bool
    hz: u32
    exchanges: u64
    high_clocks: u32
    frame: [6]u8
    frame_at: usize
    reply: [520]u8
    reply_at: usize
    reply_count: usize
    app: bool
    idle: bool
    init_left: u32
    forever_idle: bool
    absent: bool
    echo: u32
    ocr: u32
    crc_on: bool
    bad_crc: bool
    read_token: u8
    no_data: bool
    reject: u8
    status: u8
    busy: u32
    stuck_program: bool
    programming: bool
    write_at: u32
    write_stage: u32
    write_data: [514]u8
    write_count: usize
    fail_at: u64
    response_delay: u32
    last_read: u32
    last_write: u32
    block_length: u32
    hcs: bool
    resets: u32
    command_error: u8
    command_status: u8
    writes: u32
    time: *Time

private fake(time: *Time, legacy: bool = false, block: bool = true, sectors: u32 = 2048) -> Fake
    var c: [16]u8 = [0;16]
    c[4] = 1
    c[5] = 0x49
    if block
        c[0] = 0x40
        val size = sectors / 1024 - 1
        c[7] = u8.wrap(size >> 16)
        c[8] = u8.wrap(size >> 8)
        c[9] = u8.wrap(size)
    else
        val size = sectors / 4 - 1
        c[6] = u8.wrap(size >> 10)
        c[7] = u8.wrap(size >> 2)
        c[8] = u8((size & 3) << 6)
    c[15] = ref_command(c[..<15])
    Fake(storage = buf_filled(usize(sectors) * 512,0), legacy = legacy, block = block, csd = c,
        active = false, hz = 0, exchanges = 0, high_clocks = 0, frame = [0;6], frame_at = 0,
        reply = [0;520], reply_at = 0, reply_count = 0, app = false, idle = true, init_left = 2,
        forever_idle = false, absent = false, echo = 0x1aa, ocr = if block then 0xc0ff8000 else 0x80ff8000,
        crc_on = false, bad_crc = false, read_token = 0xfe, no_data = false, reject = 5, status = 0,
        busy = 0, stuck_program = false, programming = false, write_at = 0, write_stage = 0,
        write_data = [0;514], write_count = 0, fail_at = 0xffffffffffffffff, response_delay = 1,
        last_read = 0, last_write = 0, block_length = 0, hcs = false, resets = 0,
        command_error = 255, command_status = 0, writes = 0, time = time)

private push(c: *Fake, byte: u8)
    assert(c.reply_count < c.reply.len)
    c.reply[c.reply_count] = byte
    c.reply_count += 1
private response(c: *Fake, status: u8)
    for i in 0..<c.response_delay do push(c,0xff)
    push(c,status)
private packet(c: *Fake, data: []const u8)
    if c.no_data then return
    push(c,0xff)
    push(c,c.read_token)
    if c.read_token != 0xfe then return
    for byte in data do push(c,byte)
    val crc = ref_crc(data) ^ (if c.bad_crc then 1u16 else 0)
    push(c,u8.wrap(crc >> 8))
    push(c,u8.wrap(crc))
private sector(c: *Fake, arg: u32) -> Option[u32]
    if !c.block && arg & 511 != 0 then return None
    val at = if c.block then u64(arg) * 512 else u64(arg)
    if at + 512 > u64(c.storage.len()) then None else Some(u32(at))

private dispatch(c: *Fake)
    val index = c.frame[0] & 63
    assert(c.frame[5] == ref_command(c.frame[..<5]),"command CRC must be valid")
    val arg = (u32(c.frame[1]) << 24) | (u32(c.frame[2]) << 16) | (u32(c.frame[3]) << 8) | u32(c.frame[4])
    if index == c.command_error
        response(c,c.command_status)
        return
    if index == 0
        assert(c.high_clocks >= 74 && c.hz <= 400000)
        c.idle = true
        c.crc_on = false
        c.resets += 1
        response(c,1)
    elif index == 8
        response(c,if c.legacy then 5 else 1)
        if !c.legacy
            for shift in [24u32,16,8,0] do push(c,u8.wrap(c.echo >> shift))
    elif index == 55
        c.app = true
        response(c,if c.idle then 1 else 0)
    elif index == 41
        assert(c.app)
        c.app = false
        c.hcs = arg & 0x40000000 != 0
        if c.init_left > 0 then c.init_left -= 1
        elif !c.forever_idle then c.idle = false
        response(c,if c.idle then 1 else 0)
    elif index == 58
        response(c,0)
        for shift in [24u32,16,8,0] do push(c,u8.wrap(c.ocr >> shift))
    elif index == 16
        assert(!c.block && arg == 512)
        c.block_length = arg
        response(c,0)
    elif index == 59
        c.crc_on = arg == 1
        response(c,0)
    elif index == 9
        response(c,0)
        packet(c,c.csd[..])
    elif index == 17 || index == 24
        if index == 17 then c.last_read = arg
        else
            c.last_write = arg
            c.writes += 1
        sector(c,arg) match
            None -> response(c,0x20)
            Some(at) ->
                response(c,0)
                if index == 17
                    c.last_read = arg
                    packet(c,c.storage.view()[usize(at)..<usize(at + 512)])
                else
                    c.last_write = arg
                    c.write_at = at
                    c.write_stage = 1
    elif index == 13
        response(c,0)
        push(c,c.status)
    else response(c,4)

impl Device for Fake
    configure(*self, cfg: Config) -> Result[unit,BusError]
        assert(!self.active)
        assert(cfg.mode == Mode.M0 && cfg.order == BitOrder.MsbFirst)
        self.hz = cfg.hz
        Ok(())
    select(*self) -> Result[unit,BusError]
        self.active = true
        Ok(())
    deselect(*self) -> Result[unit,BusError]
        self.active = false
        self.frame_at = 0
        self.reply_at = 0
        self.reply_count = 0
        self.write_stage = 0
        Ok(())
    exchange(*self, byte: u8) -> Result[u8,BusError]
        self.time.now += self.time.tick
        self.exchanges += 1
        if self.exchanges == self.fail_at then return Err(BusError.Io)
        if !self.active
            self.high_clocks += 8
            return Ok(0xff)
        if self.absent then return Ok(0xff)
        if self.reply_at < self.reply_count
            val result = self.reply[self.reply_at]
            self.reply_at += 1
            return Ok(result)
        if self.busy > 0
            self.busy -= 1
            return Ok(0)
        if self.programming && self.stuck_program then return Ok(0)
        if self.write_stage == 1
            if byte == 0xfe
                self.write_stage = 2
                self.write_count = 0
            else assert(byte == 0xff)
            return Ok(0xff)
        if self.write_stage == 2
            self.write_data[self.write_count] = byte
            self.write_count += 1
            if self.write_count == 514
                assert(((u16(self.write_data[512]) << 8) | u16(self.write_data[513])) == ref_crc(self.write_data[..<512]),"write data CRC must be valid")
                if self.reject == 5
                    for i in 0usize..<512 do self.storage.set(usize(self.write_at) + i,self.write_data[i])
                    self.busy = 2
                    self.programming = true
                self.reply_at = 0
                self.reply_count = 0
                push(self,self.reject)
                self.write_stage = 0
            return Ok(0xff)
        if self.frame_at != 0 || byte & 0xc0 == 0x40
            self.frame[self.frame_at] = byte
            self.frame_at += 1
            if self.frame_at == 6
                self.frame_at = 0
                self.reply_at = 0
                self.reply_count = 0
                dispatch(self)
        Ok(0xff)

private opened(time: *Time, legacy: bool = false, block: bool = true) -> Card[Fake,FakeClock]
    var c = card(fake(time,legacy,block),FakeClock(time))
    c.initialize().unwrap()
    c

@test("SPI initialization: v1/v2 SDSC and SDHC negotiate voltage, HCS, CRC, capacity and clock")
initialization()
    for legacy in [false,true]
        for block in [false,true]
            if legacy && block then continue
            var time = Time(0,1)
            var c = opened(&time,legacy,block)
            val info = c.information().unwrap()
            assert(info.sectors == 2048 && info.block_addressed() == block)
            assert(c.bus.hcs == !legacy && c.bus.crc_on && !c.bus.active && c.bus.hz == 8000000)
            assert(c.bus.block_length == (if block then 0u32 else 512u32))
            assert(c.bus.resets == 1)

@test("SPI sectors: exact read/write, both addressing modes, programming status and last sector")
sector_roundtrip()
    for block in [false,true]
        var time = Time(0,1)
        var c = opened(&time,false,block)
        var bytes: [512]u8
        for i in 0..<512 do bytes[i] = u8.wrap(i ^ (i >> 4))
        var out: [512]u8
        for lba in [0u64,1,2047]
            assert(c.write_sector(lba,bytes[..]).is_ok())
            assert(c.read_sector(lba,out[..]).is_ok())
            assert(out == bytes && !c.bus.active && c.bus.busy == 0)
            assert(c.bus.last_read == u32(if block then lba else lba * 512))
            assert(c.bus.last_write == c.bus.last_read)
        assert(c.sync().is_ok())

@test("SPI validation: uninitialized card, settings, length, range and CSD write protection perform no transfer")
validation()
    var time = Time(0,1)
    var c = card(fake(&time),FakeClock(&time))
    var bytes: [512]u8
    assert(c.read_sector(0,bytes[..]) == Err(Error.NotInitialized) && c.sync() == Err(Error.NotInitialized))
    assert(c.bus.exchanges == 0)
    c.config = settings(initial_hz = 400001)
    assert(c.initialize() == Err(Error.InvalidSettings) && c.bus.exchanges == 0)
    c.config = settings()
    c.initialize().unwrap()
    val before = c.bus.exchanges
    assert(c.read_sector(0,bytes[..<511]) == Err(Error.BadLength))
    assert(c.write_sector(2048,bytes[..]) == Err(Error.OutOfRange))
    assert(c.read_sector(0xffffffffffffffff,bytes[..]) == Err(Error.OutOfRange))
    assert(c.bus.exchanges == before)
    c.bus.csd[14] = 0x20
    c.initialize().unwrap()
    val protected_at = c.bus.exchanges
    assert(c.write_sector(0,bytes[..]) == Err(Error.WriteProtected) && c.bus.exchanges == protected_at)

// Initializes a card on the given peer and checks what every failure owes:
// CS released and no card published.
private failed_initialize(bus: Fake, time: *Time, config: Settings = settings()) -> Result[Info,Error]
    var c = card(bus,FakeClock(time),config)
    val result = c.initialize()
    assert(result.is_err() && !c.bus.active && c.information().is_none() && c.info == NO_INFO)
    result

@test("SPI initialization errors: a wrong check pattern in the SEND_IF_COND echo")
bad_echo()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.echo = 0x1ab
    assert(failed_initialize(bus,&time) == Err(Error.Echo))

@test("SPI initialization errors: a v2 card that refuses the 2.7-3.6 V range")
refused_voltage()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.echo = 0x2aa
    assert(failed_initialize(bus,&time) == Err(Error.Voltage))

@test("SPI initialization errors: an OCR without the 3.2-3.4 V window")
ocr_voltage()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.ocr = 0x40000000
    assert(failed_initialize(bus,&time) == Err(Error.Voltage))

@test("SPI initialization errors: CCS and the CSD structure disagree")
ccs_csd_disagree()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.csd[0] = 0
    assert(failed_initialize(bus,&time) == Err(Error.InvalidCsd))

@test("SPI initialization errors: an R1 error bit on APP_CMD is reported as R1")
app_cmd_error()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.command_error = 55
    bus.command_status = 8
    assert(failed_initialize(bus,&time) == Err(Error.R1(8)))

@test("SPI initialization errors: a failed reinitialization forgets the previous card")
reinitialize_fails()
    var time = Time(0,1)
    var c = opened(&time)
    assert(c.information().is_some())
    c.bus.echo = 0x1ab
    assert(c.initialize() == Err(Error.Echo) && c.information().is_none() && c.info == NO_INFO && !c.bus.active)

// A read on an initialized card whose peer was then broken; CS must be
// released, and the card must read again once the fault is gone.
private failed_read(c: *Card[Fake,FakeClock]) -> Result[unit,Error]
    var out: [512]u8
    val result = c.read_sector(0,out[..])
    assert(!c.bus.active)
    c.bus.read_token = 0xfe
    c.bus.no_data = false
    c.bus.bad_crc = false
    c.bus.command_error = 255
    assert(c.read_sector(0,out[..]).is_ok())
    result

@test("SPI read errors: a data error token is reported with its value")
read_error_token()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.read_token = 0x0d
    assert(failed_read(&c) == Err(Error.ReadToken(0x0d)))

@test("SPI read errors: no data token within the poll limit is a read-token timeout")
read_token_timeout()
    var time = Time(0,1)
    var c = opened(&time)
    c.config.poll_limit = 16
    c.bus.no_data = true
    assert(failed_read(&c) == Err(Error.Timeout(Phase.ReadToken)))

@test("SPI read errors: an R1 error on READ_SINGLE_BLOCK is reported as R1")
read_r1_error()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.command_error = 17
    c.bus.command_status = 0x20
    assert(failed_read(&c) == Err(Error.R1(0x20)))

@test("SPI read errors: a data CRC mismatch is reported as Crc")
read_crc_error()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.bad_crc = true
    assert(failed_read(&c) == Err(Error.Crc))

// A write the card fails; it is sent exactly once and never retried.
private failed_write(c: *Card[Fake,FakeClock]) -> Result[unit,Error]
    c.config.poll_limit = 16
    val bytes: [512]u8 = [0xa5;512]
    val result = c.write_sector(1,bytes[..])
    assert(!c.bus.active && c.bus.last_write == 1 && c.bus.writes == 1)
    result

@test("SPI write errors: a CRC-error data response is a rejection, not retried")
write_crc_rejected()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.reject = 0x0b
    assert(failed_write(&c) == Err(Error.WriteRejected(0x0b)))

@test("SPI write errors: a write-error data response is a rejection, not retried")
write_error_rejected()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.reject = 0x0d
    assert(failed_write(&c) == Err(Error.WriteRejected(0x0d)))

@test("SPI write errors: a card that stays busy is a programming timeout")
write_busy_timeout()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.stuck_program = true
    assert(failed_write(&c) == Err(Error.Timeout(Phase.Program)))

@test("SPI write errors: an error in the CMD13 status after programming is reported as R2")
write_status_error()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.status = 0x20
    assert(failed_write(&c) == Err(Error.R2(0x20)))

private short_settings() -> Settings = settings(poll_limit = 8, initialize_us = 10000)

@test("SPI timeouts: an absent card never leaves the reset phase")
absent_card()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.absent = true
    assert(failed_initialize(bus,&time,short_settings()) == Err(Error.Timeout(Phase.Reset)))

@test("SPI timeouts: a card that stays idle times out initialization")
forever_idle()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.forever_idle = true
    assert(failed_initialize(bus,&time,short_settings()) == Err(Error.Timeout(Phase.Initialize)))

@test("SPI timeouts: a response later than the poll bound is a reset timeout")
late_response()
    var time = Time(0,1)
    var bus = fake(&time)
    bus.response_delay = 17
    assert(failed_initialize(bus,&time,short_settings()) == Err(Error.Timeout(Phase.Reset)))

@test("SPI timeouts: a frozen clock is still bounded by the poll limit")
frozen_clock()
    var time = Time(0,0)
    var bus = fake(&time)
    bus.forever_idle = true
    var c = card(bus,FakeClock(&time),short_settings())
    assert(c.initialize() == Err(Error.Timeout(Phase.Initialize)))
    assert(c.bus.exchanges < 1000 && !c.bus.active)

@test("SPI timeouts: a timer that wraps during initialization still initializes")
wrapping_clock()
    var wrapping = Time(0xfffffffffffff800,1)
    var c = card(fake(&wrapping),FakeClock(&wrapping))
    assert(c.initialize().is_ok())

@test("SPI clocks: two cards in one test keep separate clocks")
separate_clocks()
    var a = Time(0,1)
    var b = Time(1000,3)
    var ca = card(fake(&a),FakeClock(&a))
    var cb = card(fake(&b),FakeClock(&b))
    ca.initialize().unwrap()
    val a_after = a.now
    assert(a_after > 0 && b.now == 1000)
    cb.initialize().unwrap()
    assert(a.now == a_after && b.now > 1000)
    assert(ca.clock.time == &a && cb.clock.time == &b)

@test("SPI bus failure: a mid-sector error is propagated, CS is released and initialization can be retried")
bus_failure()
    var time = Time(0,1)
    var c = opened(&time)
    c.bus.fail_at = c.bus.exchanges + 64
    var out: [512]u8
    assert(c.read_sector(0,out[..]) == Err(Error.Bus(BusError.Io)) && !c.bus.active)
    assert(c.initialize().is_ok() && c.read_sector(0,out[..]).is_ok())

@test("SPI CRC policy: disabling data checking does not disable valid command/write CRC generation")
crc_policy()
    var time = Time(0,1)
    var c = card(fake(&time),FakeClock(&time),settings(check_crc = false))
    c.initialize().unwrap()
    assert(!c.bus.crc_on)
    c.bus.bad_crc = true
    var out: [512]u8
    assert(c.read_sector(0,out[..]).is_ok())
    assert(c.write_sector(0,out[..]).is_ok())

#if feature_fat
import sh.sysl.fat.{BlockDevice,DeviceError,FatType,format,mount}

@test("FAT adapter: format, mount, file write/read and flush run through actual SPI card commands")
fat_roundtrip()
    var time = Time(0,1)
    var c = card(fake(&time,false,true,32768),FakeClock(&time))
    c.initialize().unwrap()
    assert(c.sector_size() == 512 && c.sectors() == 32768)
    format(&c,Some(FatType.Fat16),label = "SD TEST").unwrap()
    var scratch: [512]u8
    var volume = mount(&c,scratch[..]).unwrap()
    var file = volume.create("/Recorded audio.wav").unwrap()
    val content: [1300]u8 = [0x5a;1300]
    assert(volume.write(&file,content[..]).unwrap() == 1300)
    volume.flush().unwrap()
    var reopened = volume.open("/Recorded audio.wav").unwrap()
    var readback: [1300]u8
    assert(volume.read(&reopened,readback[..]).unwrap() == 1300 && readback == content)
    var out: [512]u8
    assert(c.read(32768,out[..]) == Err(DeviceError.OutOfRange))
    assert(c.read(0,out[..<511]) == Err(DeviceError.BadLength))
    assert(!c.bus.active)

@test("FAT adapter: a failing SPI card reaches the caller as Io carrying sd's own code, unchanged")
fat_io_code()
    var time = Time(0,1)
    var c = opened(&time)
    var out: [512]u8
    c.bus.command_error = 17
    c.bus.command_status = 0x20
    assert(c.read(0,out[..]) == Err(DeviceError.Io(9)))
    c.bus.command_error = 0
    c.bus.bad_crc = true
    assert(c.read(0,out[..]) == Err(DeviceError.Io(17)))
    assert(!c.bus.active)
#endif

@test("SPI address boundaries: 64-bit sector counts retain full 32-bit block/byte arguments")
address_boundaries()
    var out: [512]u8
    var time = Time(0,1)
    var hc = opened(&time)
    hc.info.sectors = 4294967296
    // The small test peer rejects these sectors, but records the actual wire
    // argument, independently proving that the driver did not truncate early.
    assert(hc.read_sector(4294967295,out[..]) == Err(Error.R1(0x20)))
    assert(hc.bus.last_read == 0xffffffff)
    val before = hc.bus.exchanges
    assert(hc.read_sector(4294967296,out[..]) == Err(Error.OutOfRange) && hc.bus.exchanges == before)
    var sc = opened(&time,false,false)
    sc.info.sectors = 4194304
    assert(sc.read_sector(4194303,out[..]) == Err(Error.R1(0x20)))
    assert(sc.bus.last_read == 0x7ffffe00)

@test("SPI multi-sector: a run of sectors reads and writes one sector command at a time")
multi_sector()
    for block in [false,true]
        var time = Time(0,1)
        var c = opened(&time,false,block)
        var bytes: [1536]u8
        for i in 0..<bytes.len do bytes[i] = u8.wrap(i * 7 + i / 512)
        c.write_sectors(2045,bytes[..]).unwrap()
        assert(c.bus.writes == 3 && c.bus.last_write == u32(if block then 2047 else 2047 * 512))
        var out: [1536]u8
        c.read_sectors(2045,out[..]).unwrap()
        assert(out == bytes && !c.bus.active)
        var one: [512]u8
        c.read_sector(2046,one[..]).unwrap()
        assert(one[..] == bytes[512..<1024])

@test("SPI multi-sector: refusals come before any transfer, and an empty run at the end is accepted")
multi_sector_refusals()
    var time = Time(0,1)
    var unopened = card(fake(&time),FakeClock(&time))
    var bytes: [1024]u8
    assert(unopened.read_sectors(0,bytes[..]) == Err(Error.NotInitialized) && unopened.bus.exchanges == 0)
    var c = opened(&time)
    val before = c.bus.exchanges
    assert(c.read_sectors(2047,bytes[..]) == Err(Error.OutOfRange))
    assert(c.write_sectors(0,bytes[..<513]) == Err(Error.BadLength))
    assert(c.read_sectors(2048,[]).is_ok() && c.write_sectors(2048,[]).is_ok())
    assert(c.bus.exchanges == before)

@test("SPI multi-sector: a failure partway stops the run and reports the sector's error")
multi_sector_failure()
    var time = Time(0,1)
    var c = opened(&time)
    c.config.poll_limit = 16
    c.bus.reject = 0x0d
    var bytes: [1536]u8
    assert(c.write_sectors(0,bytes[..]) == Err(Error.WriteRejected(0x0d)))
    assert(c.bus.writes == 1 && !c.bus.active)
