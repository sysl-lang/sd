module sh.sysl.sd
@tests

import sh.sysl.spi.Error as BusError

@test("CRC: SD command golden vectors and CCITT data vector, including empty input")
crc_vectors()
    assert(crc7([0x40u8,0,0,0,0]) == 0x4a)
    assert(crc7([0x48u8,0,0,1,0xaa]) == 0x43)
    assert(crc7([]) == 0 && crc16([]) == 0)
    assert(crc16("123456789".bytes) == 0x31c3)
    val ones: [512]u8 = [0xff;512]
    assert(crc16(ones[..]) == 0x7fa1)

private csd2(size: u32) -> [16]u8
    var c: [16]u8 = [0;16]
    c[0] = 0x40
    c[4] = 1
    c[5] = 0x49
    c[7] = u8(size >> 16)
    c[8] = u8(size >> 8)
    c[9] = u8(size)
    c

@test("CSD v2: minimum field, SDHC/SDXC boundary, full 2TiB capacity and write protection")
csd_capacity_v2()
    for size in [0u32,65535,65536,0x3fffff]
        val c = csd2(size)
        val info = csd_info(c[..],true).unwrap()
        assert(info.sectors == (u64(size) + 1) * 1024)
        assert(info.bytes() == info.sectors * 512 && info.block_addressed())
        assert(info.kind == (if size < 65536 then CardKind.Sdhc else CardKind.Sdxc))
    var c = csd2(1)
    assert(csd_info(c[..],false) == Err(Error.InvalidCsd))
    c[14] = 0x10
    assert(csd_info(c[..],true).unwrap().write_protected)
    c[14] = 0x20
    assert(csd_info(c[..],true).unwrap().write_protected)
    c[14] = 0
    c[4] = 0
    assert(csd_info(c[..],true).unwrap().write_protected,"missing write command class is read-only")
    c[5] = 9
    assert(csd_info(c[..],true) == Err(Error.InvalidCsd),"read command class is required")

@test("CSD v1: every legal block length/multiplier, byte addressing and malformed registers")
csd_capacity_v1()
    for length in 9u32..<12
        for mult in 0u32..<8
            var c: [16]u8 = [0;16]
            c[4] = 1
            c[5] = 0x40 | u8(length)
            c[6] = 3
            c[7] = 0xff
            c[8] = 0xc0
            c[9] = u8(mult >> 1)
            c[10] = u8((mult & 1) << 7)
            val bytes = 4096u64 << (mult + 2 + length)
            if bytes > 2147483648
                assert(csd_info(c[..],false) == Err(Error.InvalidCsd))
            else
                val info = csd_info(c[..],false).unwrap()
                assert(info.bytes() == bytes && !info.block_addressed() && info.kind == CardKind.Sdsc)
    var c = csd2(1)
    c[0] = 0
    c[5] = 0x48
    assert(csd_info(c[..],false) == Err(Error.InvalidCsd))
    c[0] = 0x80
    assert(csd_info(c[..],true) == Err(Error.UnsupportedCsd(2)))
    c[0] = 0xc0
    assert(csd_info(c[..],true) == Err(Error.UnsupportedCsd(3)))
    assert(csd_info(c[..<15],true) == Err(Error.BadLength))

@test("settings: the defaults validate, and a named argument changes only its own field")
settings_defaults()
    val d = settings()
    assert(d.validate().is_ok())
    assert(d.initial_hz == 400000 && d.transfer_hz == 8000000 && d.initialize_us == 1000000)
    assert(d.read_us == 200000 && d.program_us == 500000 && d.poll_limit == 1000000 && d.check_crc)
    val s = settings(read_us = 7, check_crc = false)
    assert(s.read_us == 7 && !s.check_crc && s.program_us == 500000 && s.transfer_hz == 8000000)

@test("settings: each clock bound is inclusive and each deadline must be non-zero")
settings_bounds()
    assert(settings(initial_hz = 100000).validate().is_ok())
    assert(settings(initial_hz = 99999).validate() == Err(Error.InvalidSettings))
    assert(settings(initial_hz = 400001).validate() == Err(Error.InvalidSettings))
    assert(settings(transfer_hz = 25000000).validate().is_ok())
    assert(settings(transfer_hz = 25000001).validate() == Err(Error.InvalidSettings))
    assert(settings(initial_hz = 300000, transfer_hz = 300000).validate().is_ok())
    assert(settings(initial_hz = 300000, transfer_hz = 299999).validate() == Err(Error.InvalidSettings))
    assert(settings(initialize_us = 0).validate() == Err(Error.InvalidSettings))
    assert(settings(read_us = 0).validate() == Err(Error.InvalidSettings))
    assert(settings(program_us = 0).validate() == Err(Error.InvalidSettings))
    assert(settings(poll_limit = 0).validate() == Err(Error.InvalidSettings))

@test("sector argument: block numbers on SDHC, byte offsets on SDSC, every refusal before any transfer")
sector_argument()
    val hc = Some(Info(CardKind.Sdhc,4294967296,false))
    assert(argument(None,0,SECTOR_SIZE) == Err(Error.NotInitialized))
    assert(argument(hc,0,SECTOR_SIZE - 1) == Err(Error.BadLength))
    assert(argument(hc,4294967295,SECTOR_SIZE) == Ok(0xffffffff))
    assert(argument(hc,4294967296,SECTOR_SIZE) == Err(Error.OutOfRange))
    val sc = Some(Info(CardKind.Sdsc,8388608,false))
    assert(argument(sc,3,SECTOR_SIZE) == Ok(1536))
    assert(argument(sc,8388607,SECTOR_SIZE) == Ok(0xfffffe00))
    assert(argument(sc,8388608,SECTOR_SIZE) == Err(Error.OutOfRange))
    val small = Some(Info(CardKind.Sdsc,8388610,false))
    assert(argument(small,8388608,SECTOR_SIZE) == Err(Error.OutOfRange),"a byte offset past 32 bits")

@test("sector span: whole sectors that end on the card, an empty run at the end included")
sector_span()
    val card = Some(Info(CardKind.Sdhc,8,false))
    assert(span(None,0,0) == Err(Error.NotInitialized))
    assert(span(card,0,8 * SECTOR_SIZE).is_ok() && span(card,8,0).is_ok())
    assert(span(card,1,8 * SECTOR_SIZE) == Err(Error.OutOfRange))
    assert(span(card,9,0) == Err(Error.OutOfRange))
    assert(span(card,0,SECTOR_SIZE + 1) == Err(Error.BadLength))

@test("finish: the operation's error wins, and the cleanup's is reported after a success")
finish_order()
    val one: Result[int,Error] = Ok(1)
    val failed: Result[int,Error] = Err(Error.Crc)
    assert(finish(one,Ok(())) == Ok(1))
    assert(finish(failed,Err(Error.Echo)) == Err(Error.Crc))
    assert(finish(one,Err(Error.Echo)) == Err(Error.Echo))
    assert(finish(failed,Ok(())) == Err(Error.Crc))

private bus_failure() -> Result[unit,Error]
    val failed: Result[unit,BusError] = Err(BusError.Timeout)
    failed?
    Ok(())

private host_failure() -> Result[unit,Error]
    val failed: Result[unit,HostError] = Err(HostError.DataCrc)
    failed?
    Ok(())

@test("errors: `?` carries SPI and host transport failures into their own variants")
error_conversions()
    assert(bus_failure() == Err(Error.Bus(BusError.Timeout)))
    assert(host_failure() == Err(Error.Host(HostError.DataCrc)))

#if feature_fat
@test("FAT adapter errors: range and length keep their meaning, every other failure is Io")
fat_device_result()
    assert(device_result(Ok(())).is_ok())
    assert(device_result(Err(Error.BadLength)) == Err(sh.sysl.fat.DeviceError.BadLength))
    assert(device_result(Err(Error.OutOfRange)) == Err(sh.sysl.fat.DeviceError.OutOfRange))
    assert(device_result(Err(Error.Host(HostError.Io))) == Err(sh.sysl.fat.DeviceError.Io))
    assert(device_result(Err(Error.R1(4))) == Err(sh.sysl.fat.DeviceError.Io))
#endif
